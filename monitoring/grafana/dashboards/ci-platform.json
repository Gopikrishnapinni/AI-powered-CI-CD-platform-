{
  "title": "CI Platform Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"ci-platform-api\"}[5m]))", "legendFormat": "requests/sec"}]
    },
    {
      "type": "stat",
      "title": "Healthy instances",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "up{job=\"backend\"}", "legendFormat": "backend"}]
    }
  ]
}
